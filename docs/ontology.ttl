#################################################################
#    Object Properties
#################################################################

###  https://l-jamora.github.io/m150-onto#connectedWith
:connectedWith rdf:type owl:ObjectProperty ,
                        owl:SymmetricProperty ,
                        owl:TransitiveProperty ;
               rdfs:domain :Component ;
               rdfs:range :Component ;
               rdfs:comment "Superclass for TopNodes and BottomNodes classification (HG003, HG004, HG005)"@en .


###  https://l-jamora.github.io/m150-onto#flowsFrom
:flowsFrom rdf:type owl:ObjectProperty ;
           owl:equivalentProperty :hasPipeSectionTopNodeDesignation ;
           rdfs:subPropertyOf :connectedWith ;
           owl:inverseOf :flowsTo ;
           rdf:type owl:AsymmetricProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:comment "BottomNodeDesignation flowsFrom TopNodeDesignation"@en ;
           rdfs:label "fließtVon"@de .


###  https://l-jamora.github.io/m150-onto#flowsTo
:flowsTo rdf:type owl:ObjectProperty ;
         owl:equivalentProperty :hasPipeSectionBottomNodeDesignation ;
         rdfs:subPropertyOf :connectedWith ;
         rdf:type owl:AsymmetricProperty ,
                  owl:IrreflexiveProperty ;
         rdfs:comment "TopNodeDesignation flowsTo BottomNodeDesignation"@en .


###  https://l-jamora.github.io/m150-onto#hasAreaCode
:hasAreaCode rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasBasicData ;
             rdf:type owl:FunctionalProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:range :AreaCode .


###  https://l-jamora.github.io/m150-onto#hasAssessor
:hasAssessor rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasInspectionData ;
             rdf:type owl:FunctionalProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:range :Person .


###  https://l-jamora.github.io/m150-onto#hasBackflowPrevention
:hasBackflowPrevention rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :hasInspectionData ;
                       rdf:type owl:FunctionalProperty ,
                                owl:AsymmetricProperty ,
                                owl:IrreflexiveProperty ;
                       rdfs:range :BackflowPrevention .


###  https://l-jamora.github.io/m150-onto#hasBasicData
:hasBasicData rdf:type owl:ObjectProperty ,
                       owl:IrreflexiveProperty .


###  https://l-jamora.github.io/m150-onto#hasCameraSystemUsed
:hasCameraSystemUsed rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :hasInspectionData ;
                     rdf:type owl:FunctionalProperty ,
                              owl:AsymmetricProperty ,
                              owl:IrreflexiveProperty ;
                     rdfs:range :CameraSystem .


###  https://l-jamora.github.io/m150-onto#hasCatchmentAreaCode
:hasCatchmentAreaCode rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :hasBasicData ;
                      rdf:type owl:FunctionalProperty ,
                               owl:AsymmetricProperty ,
                               owl:IrreflexiveProperty ;
                      rdfs:range :CatchmentAreaCode .


###  https://l-jamora.github.io/m150-onto#hasClassifier
:hasClassifier rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :hasConditionData ;
               rdf:type owl:FunctionalProperty ,
                        owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:range :Person .


###  https://l-jamora.github.io/m150-onto#hasCleaning
:hasCleaning rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasInspectionData ;
             rdf:type owl:FunctionalProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:range :Cleaning .


###  https://l-jamora.github.io/m150-onto#hasClient
:hasClient rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :hasInspectionData ;
           rdf:type owl:FunctionalProperty ,
                    owl:AsymmetricProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:range :Person .


###  https://l-jamora.github.io/m150-onto#hasCodingSystem
:hasCodingSystem rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :hasInspectionData ;
                 rdf:type owl:FunctionalProperty ,
                          owl:AsymmetricProperty ,
                          owl:IrreflexiveProperty ;
                 rdfs:range :CodingSystem .


###  https://l-jamora.github.io/m150-onto#hasCompany
:hasCompany rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :hasInspectionData ;
            rdf:type owl:FunctionalProperty ,
                     owl:AsymmetricProperty ,
                     owl:IrreflexiveProperty ;
            rdfs:range :Organization .


###  https://l-jamora.github.io/m150-onto#hasConditionData
:hasConditionData rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :hasInspectionData ;
                  rdf:type owl:AsymmetricProperty ,
                           owl:IrreflexiveProperty .


###  https://l-jamora.github.io/m150-onto#hasCoordinateSystem
:hasCoordinateSystem rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :hasGeometryPointData ;
                     rdf:type owl:FunctionalProperty ,
